# DocFlow 로컬 개발 환경변수 예시
# 사용법: cp .env.example .env 후 값을 수정한다. (.env는 Git에 포함하지 않는다)

# --- PostgreSQL (docker-compose.yml) ---
POSTGRES_DB=docflow
POSTGRES_USER=docflow
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# --- Backend (Spring Boot) ---
# backend/에서 실행하면 application.yml이 이 파일(../.env)을 자동으로 읽는다.
DB_URL=jdbc:postgresql://localhost:5432/docflow
DB_USERNAME=docflow
DB_PASSWORD=change-me

# --- Frontend (Next.js) ---
# next.config.ts의 rewrites가 사용한다. frontend/에서 실행할 때는 셸 환경변수로 지정한다.
BACKEND_URL=http://localhost:8080
